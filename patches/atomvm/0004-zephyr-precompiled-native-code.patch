diff --git a/src/platforms/zephyr/src/lib/sys.c b/src/platforms/zephyr/src/lib/sys.c
index 914fb707..412103dd 100644
--- a/src/platforms/zephyr/src/lib/sys.c
+++ b/src/platforms/zephyr/src/lib/sys.c
@@ -809,3 +809,49 @@ void sys_mbedtls_ctr_drbg_context_unlock(GlobalContext *global)
     UNUSED(global);
 }
 #endif
+
+#ifndef AVM_NO_JIT
+// Precompiled (AOT) native code is executed in place from the AVM pack.
+ModuleNativeEntryPoint sys_map_native_code(const uint8_t *code, size_t code_size)
+{
+    UNUSED(code_size);
+#if defined(__riscv)
+    // The pack may have been copied to RAM after boot: make the instruction fetch see it
+    __asm__ volatile("fence.i" ::: "memory");
+#endif
+    return (ModuleNativeEntryPoint) code;
+}
+
+void sys_release_native_code(ModuleNativeEntryPoint entry_point)
+{
+    // Native code points into the AVM pack; nothing to free
+    UNUSED(entry_point);
+}
+
+bool sys_get_cache_native_code(GlobalContext *global, Module *mod, uint16_t *version, ModuleNativeEntryPoint *entry_point, uint32_t *labels)
+{
+    UNUSED(global);
+    UNUSED(mod);
+    UNUSED(version);
+    UNUSED(entry_point);
+    UNUSED(labels);
+    return false;
+}
+
+void sys_set_cache_native_code(GlobalContext *global, Module *mod, uint16_t version, ModuleNativeEntryPoint entry_point, uint32_t labels)
+{
+    UNUSED(global);
+    UNUSED(mod);
+    UNUSED(version);
+    UNUSED(entry_point);
+    UNUSED(labels);
+}
+
+// No JIT stream on this port: only precompiled code is executed
+ModuleNativeEntryPoint jit_stream_entry_point(Context *ctx, term jit_stream)
+{
+    UNUSED(ctx);
+    UNUSED(jit_stream);
+    return NULL;
+}
+#endif
